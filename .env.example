# Address and port the HTTP server binds to.
KOSYNC_RS_HOST=0.0.0.0
KOSYNC_RS_PORT=8090

# SQLite connection string.
KOSYNC_RS_DATABASE_URL=sqlite://data/kosync.db

# Password for the seeded `admin` user (MD5-hashed before storage).
KOSYNC_RS_ADMIN_PASSWORD=admin

# Public self-registration via /users/create. Disabled by default: accounts are
# created by an administrator in the web UI at /admin/users. Set to `false` to
# allow anyone to register.
KOSYNC_RS_REGISTRATION_DISABLED=true

# Comma-separated list of trusted reverse proxy addresses (optional).
KOSYNC_RS_TRUSTED_PROXIES=

# Set to `true` for single-line log output.
KOSYNC_RS_SINGLE_LINE_LOGGING=false

# Directory where uploaded EPUB files and generated covers are stored.
KOSYNC_RS_BOOKS_DIR=data/books

# Maximum accepted size, in bytes, for an uploaded EPUB file (default 200 MiB).
KOSYNC_RS_MAX_UPLOAD_BYTES=209715200

# Set to `true` to enrich uploaded books in the background with metadata
# (genres, ISBN, covers) fetched from external book APIs. Disabled by default:
# enabling it means outbound requests revealing the ISBNs of uploaded books.
KOSYNC_RS_METADATA_ENRICHMENT=false
